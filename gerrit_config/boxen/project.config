[access "refs/meta/config"]
	push = group Administrators

[access "refs/heads/*"]
	push = group Administrators
	label-Verified = -1..+1 group ci
	# So that a check that is red for reasons that aren't the change can be
	# overridden by hand.
	label-Verified = -1..+1 group Administrators
	submit = group ci

[label "Verified"]
	function = NoBlock
	defaultValue = 0
	value = -1 Fails
	value = 0 No score
	value = +1 Verified
	copyCondition = changekind:NO_CODE_CHANGE

[submit-requirement "Verified"]
	description = The checks have to have passed.
	submittableIf = label:Verified=MAX AND -label:Verified=MIN
	overrideIf = label:Verified=MAX,group=Administrators
	canOverrideInChildProjects = false

[submit]
	action = rebase if necessary
